{
    "compilerOptions": {
        "module": "commonjs",
        "skipLibCheck": true,
        "declaration": true,
        "removeComments": true,
        "emitDecoratorMetadata": true,
        "experimentalDecorators": true,
        "target": "es2017",
        "sourceMap": true,
        "outDir": "./dist",
        "baseUrl": "./",
        "incremental": true,
        "paths": {},
        "typeRoots": ["./types", "./node_modules/@types", "./node_modules"],
        "types": ["node"]
    },
    "exclude": [
        "node_modules",
        "dist"
    ]
}
